generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Migrate) and lib/db.ts (runtime
// adapter) — Prisma 7 removed `url` from the datasource block.
datasource db {
  provider = "sqlite"
}

// No @id field below has a @default — every id in this app is always
// exactly 10 characters, generated by lib/id.ts#generateId() at the call
// site (see every db.<model>.create() across app/actions and lib/authz.ts).
// The auth tables (User, Account, Session) get theirs the same way via the
// wrapped adapter in lib/custom-adapter.ts, since @auth/prisma-adapter
// otherwise relies on this schema-level default to exist.

model User {
  id              String           @id
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  phone           String?
  accounts        Account[]
  sessions        Session[]
  providerProfile ProviderProfile?
  brandAds        BrandAd[]
  platformMember  PlatformMember?
  shopMemberships ShopMember[]
  createdAt       DateTime         @default(now())
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A provider is a mechanic/fuel/tow/etc business. userId is unique: one
// Google account maps to at most one provider (service) listing.
model ProviderProfile {
  id             String          @id
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName   String
  // JSON-encoded array of ServiceType — a shop can offer several services.
  // Parsed via lib/authz.ts#parseServiceTypes, same convention as the
  // JSON-encoded permissions fields below.
  serviceTypes   String
  phone          String
  email          String
  description    String?
  latitude       Float
  longitude      Float
  address        String?
  isActive       Boolean         @default(true)
  products       Product[]
  services       Service[]
  rescueRequests RescueRequest[]
  shopRoles      ShopRole[]
  members        ShopMember[]
  shopAds        ShopAd[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([latitude, longitude])
}

// A provider's shop = their profile + their products. No separate Shop table.
model Product {
  id          String          @id
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int
  imageUrl    String?
  inStock     Boolean         @default(true)
  shopAds     ShopAd[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([providerId])
}

// A specific service a shop performs (e.g. "Oil change" at a set price) —
// distinct from ProviderProfile.serviceTypes, which is just the coarse
// category list (Mechanic, Tow, ...) used for search filtering. This is the
// itemized listing shops actually share with customers, same shape as Product.
model Service {
  id          String          @id
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int
  imageUrl    String?
  isAvailable Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([providerId])
}

// Platform-wide sponsored banner, shown at the top of both home pages.
// Anonymous by design: a brand never has to sign in to advertise. Anonymous
// submissions (userId null) land inactive pending admin review; a signed-in
// user's own ads stay self-serve and publish immediately, as before.
model BrandAd {
  id                String   @id
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title             String
  // The literal product name (e.g. "Skygo Oil") — distinct from `title`,
  // which can be a marketing headline. This is what "Find nearby shops"
  // (components/ads/hero-banner.tsx) searches for across every shop's
  // products, so it needs to match how shops actually name the item.
  productName       String
  description       String?
  // Optional: an advertiser can upload a photo, or skip it and get a
  // colored card rendering their title/description instead (bgColor).
  imageUrl          String?
  bgColor           String   @default("green")
  // Admin-only override for legibility when a poster is too light: "light"
  // (white text, default) or "dark" (dark text + light scrim). ctaColor
  // reuses the AdColor palette for the CTA button's background.
  textColor         String   @default("light")
  ctaColor          String   @default("green")
  linkUrl           String?
  // Set when userId is null (anonymous submission) — who to credit the ad to.
  advertiserName    String?
  // Contact info is mandatory for every ad, signed-in or anonymous.
  contactEmail      String
  contactPhone      String
  // Null targetRadiusKm = universal (always shown). Otherwise the ad only
  // shows to a customer within targetRadiusKm of the target point.
  targetLatitude    Float?
  targetLongitude   Float?
  targetRadiusKm    Float?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

// A shop's own promo for one of its products, shown inside that shop's
// listing. Null radiusKm = universal (visible to anyone who opens the shop);
// otherwise localised to that many km from the shop's own location.
model ShopAd {
  id          String          @id
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  title       String
  description String?
  imageUrl    String?
  isActive    Boolean         @default(true)
  radiusKm    Float?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([providerId])
}

// Anonymous by design: a stranded driver never has to sign in to ask for help.
model RescueRequest {
  id            String          @id
  providerId    String
  provider      ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  description   String?
  serviceType   String
  latitude      Float
  longitude     Float
  status        String          @default("PENDING")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([providerId])
}

// --- Platform-level RBAC ---------------------------------------------------
// The first person ever to sign in is auto-enrolled here (see
// lib/authz.ts#bootstrapOrReconcileUser) with the built-in "Super Admin" role.

model PlatformRole {
  id          String           @id
  name        String           @unique
  permissions String
  isSystem    Boolean          @default(false)
  members     PlatformMember[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PlatformMember {
  id          String       @id
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteEmail String       @unique
  roleId      String
  role        PlatformRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status      String       @default("PENDING")
  createdAt   DateTime     @default(now())
}

// --- Shop-level RBAC ---------------------------------------------------
// The shop owner (ProviderProfile.userId) always has every shop permission and
// is intentionally never represented as a ShopMember row.

model ShopRole {
  id          String          @id
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  permissions String
  isSystem    Boolean         @default(false)
  members     ShopMember[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([providerId, name])
}

model ShopMember {
  id          String          @id
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteEmail String
  roleId      String
  role        ShopRole        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status      String          @default("PENDING")
  createdAt   DateTime        @default(now())

  @@unique([providerId, inviteEmail])
  @@index([userId])
}
